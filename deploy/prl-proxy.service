[Unit]
Description=Local PRL Stratum Proxy
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=prl-proxy
Group=prl-proxy
WorkingDirectory=/opt/prl-stratum-proxy
ExecStart=/usr/bin/python3 -m prl_proxy run --config /etc/prl-proxy/config.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/prl-proxy

[Install]
WantedBy=multi-user.target
